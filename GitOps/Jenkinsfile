@Library('Shared') _

pipeline {

agent { label 'built-in' }

parameters {
    string(
        name: 'DOCKER_TAG',
        defaultValue: '',
        description: 'Docker image tag built by CI pipeline'
    )
}

stages {

    stage("Workspace Cleanup") {
        steps {
            cleanWs()
        }
    }

    stage("Validate Parameters") {
        steps {
            script {
                if (!params.DOCKER_TAG?.trim()) {
                    error("DOCKER_TAG is required")
                }
            }
        }
    }

    stage("Git: Code Checkout") {
        steps {
            script {
                code_checkout(
                    "https://github.com/Ahad0p/MULTI-AGENT-AI-RESEARCH-SYSTEM.git",
                    "main"
                )
            }
        }
    }

    stage("Verify Docker Tag") {
        steps {
            script {
                echo "DOCKER_TAG: ${params.DOCKER_TAG}"
            }
        }
    }

    stage("Update Kubernetes Manifest") {

        steps {

            dir('k8s') {

                sh """
                sed -i \
                's|image: ahadkhan021/multi-agent-ai-research-system:.*|image: ahadkhan021/multi-agent-ai-research-system:${params.DOCKER_TAG}|g' \
                deployment.yaml
                """

                sh "grep image deployment.yaml"
            }
        }
    }

    stage("Git: Commit and Push Changes") {

        steps {

            withCredentials([
                gitUsernamePassword(
                    credentialsId: 'Github-cred',
                    gitToolName: 'Default'
                )
            ]) {

                sh '''
                git status

                git add k8s/deployment.yaml

                git diff --cached --quiet || \
                git commit -m "Update image tag to ${DOCKER_TAG}"

                git push origin main
                '''
            }
        }
    }
}

post {

    success {

        script {

            emailext(
                attachLog: true,
                from: 'ahadkhan.ai306@gmail.com',

                subject:
                "Multi-Agent Research deployment updated - ${currentBuild.result}",

                body: """
                <html>
                <body>

                <div style="background-color:#90EE90;padding:10px;">
                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                </div>

                <div style="background-color:#87CEEB;padding:10px;">
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                </div>

                <div style="background-color:#FFA07A;padding:10px;">
                    <p><b>Docker Tag:</b> ${params.DOCKER_TAG}</p>
                </div>

                <div style="background-color:#D3D3D3;padding:10px;">
                    <p><b>URL:</b> ${env.BUILD_URL}</p>
                </div>

                </body>
                </html>
                """,

                to: 'ahadkhan.ai306@gmail.com',
                mimeType: 'text/html'
            )
        }
    }

    failure {

        script {

            emailext(
                attachLog: true,
                from: 'ahadkhan.ai306@gmail.com',

                subject:
                "Multi-Agent Research deployment failed - ${currentBuild.result}",

                body: """
                <html>
                <body>

                <div style="background-color:#FFA07A;padding:10px;">
                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                </div>

                <div style="background-color:#90EE90;padding:10px;">
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                </div>

                </body>
                </html>
                """,

                to: 'ahadkhan.ai306@gmail.com',
                mimeType: 'text/html'
            )
        }
    }
}

}
